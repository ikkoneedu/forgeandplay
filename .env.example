# KO Ekip — ortam değişkenleri
# Yerelde .env.local olarak kopyala; üretimde Vercel → Settings → Environment Variables.
# Ayrıntılı kurulum: KURULUM.md

# ---- Firebase (istemci, herkese açık değerler) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# yönetici e-postaları (virgülle)
NEXT_PUBLIC_ADMIN_EMAILS=

# ---- Firebase Admin (sunucu; hizmet hesabı JSON'unun tamamı) ----
FIREBASE_SERVICE_ACCOUNT=

# ---- Telefon bildirimleri (Web Push) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@forgeandplay.com
# cron-job.org → /api/koekip/push/cron?key=CRON_SECRET
CRON_SECRET=

# ---- Sesli oda aktarma sunucusu (Cloudflare TURN) ----
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# aylık kullanım sınırı (GB), ücretsiz kotayı aşmasın
TURN_LIMIT_GB=
# başka TURN sağlayıcısı kullanılacaksa (Cloudflare yerine)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Yalnızca yerel test: pazar verisi için sahte kaynak ----
KOHESAP_MARKET_ORIGIN=
